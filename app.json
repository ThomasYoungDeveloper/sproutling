{
  "expo": {
    "name": "Sproutling",
    "slug": "sproutling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sproutlingapp.sproutling",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Sproutling reads your steps, sleep, water, activity rings and mindful minutes so your pet can grow from your real healthy habits.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sproutlingapp.sproutling"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Sproutling"
    },
    "scheme": "sproutling",
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Sproutling reads your steps, sleep, water, activity rings and mindful minutes so your pet can grow from your real healthy habits.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7fb58d28-c6e3-4836-b963-a18f20c9808b"
      }
    }
  }
}
